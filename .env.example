# Password for /admin. The app falls back to bingo-admin when this is unset.
# Set a long password before the server is reachable by anyone else.
ADMIN_PASSWORD=bingo-admin

# Signs the admin session cookie. Use a long random string in production.
ADMIN_SESSION_SECRET=dev-only-session-secret-change-me

# SQLite file. Point this at a persistent disk when you deploy.
DATABASE_PATH=data/bingo.sqlite

# Set to 1 to mark the admin cookie Secure (HTTPS only).
# Leave unset behind plain HTTP. A proxy that sends X-Forwarded-Proto: https
# turns Secure on automatically.
# COOKIE_SECURE=1
